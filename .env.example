# Configure a verified Resend sending domain before enabling service-request email.
# CONTACT_FROM_EMAIL and CONTACT_TO_EMAIL must be plain email addresses.
# Never commit real credentials. Copy this file to .env.local, then fill values securely.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional exact HTTPS origin if a trusted reverse proxy changes the request origin.
# Leave empty for the centralized canonical domain and normal incoming Host checks.
CONTACT_SITE_ORIGIN=

# Review mode displays pending imagery/services for owner review and blocks indexing.
# Switch to public only after approval; public mode hides unapproved assets and claims.
SITE_PUBLICATION_MODE=review
